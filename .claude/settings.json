{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm run build)",
      "Bash(pnpm run ci)",
      "Bash(pnpm run format)",
      "Bash(pnpm run format:check)",
      "Bash(pnpm run check:public)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm run test:e2e:built:*)",
      "Bash(node --import tsx --test:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
