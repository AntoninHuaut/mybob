// Renovate keeps the pnpm dependencies, the packageManager pin, the pinned
// Python requirements of the plan scripts and the workflow's actions current.
//
// Routine bumps (minor, patch, digest) arrive together in one PR a week.
// Majors stay one PR each: a Babylon.js, Vite or TypeScript major usually needs code
// changes and is tested and reverted on its own. They are the only updates not
// automerged.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // best-practices adds, on top of config:recommended: actions and Docker
  // images pinned to digests, devDependencies pinned, a strict
  // minimumReleaseAge on npm (shortened to a day below), weekly lock file
  // maintenance, config migration PRs and abandoned-package warnings on the
  // dashboard.
  extends: ['config:best-practices'],
  timezone: 'Europe/Paris',
  schedule: ['* 7-12 * * 6'],
  labels: ['dependencies'],
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',
  // Security PRs already skip the Saturday schedule and the release-age
  // wait. OSV adds a second advisory source next to GitHub's, which often
  // lists a fix first. Still flagged experimental upstream (#20542).
  osvVulnerabilityAlerts: true,
  // Move the ranges in package.json along with the lockfile, as Dependabot
  // did, so package.json still says which version is installed.
  rangeStrategy: 'bump',
  // Lock file maintenance refreshes transitive dependencies, which nothing
  // else bumps. It runs in the same Saturday window, not the preset's
  // Monday; pnpm applies its own one-day minimumReleaseAge to it.
  lockFileMaintenance: {
    schedule: ['* 7-12 * * 6'],
  },
  // Everything but majors merges by itself once the required CI checks pass
  // (GitHub auto-merge, Renovate's platformAutomerge default). Majors wait
  // for a human.
  automerge: true,
  packageRules: [
    // A day instead of the preset's three: an advisory Renovate cannot see
    // (only GitHub's and OSV's raise a security PR) then waits one day, not
    // three plus the next Saturday. pnpm applies the same day to lock file
    // maintenance. matchUpdateTypes keeps the preset's opt-outs (lock file
    // maintenance, pin, replacement), which carry no release age.
    {
      matchDatasources: ['npm'],
      matchUpdateTypes: ['major', 'minor', 'patch'],
      minimumReleaseAge: '1 day',
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      groupName: 'routine updates',
      groupSlug: 'routine',
      matchUpdateTypes: ['minor', 'patch', 'digest'],
    },
    // A Python minor (3.12 → 3.13) is an ABI change: pymupdf's binary
    // dependencies (onnxruntime) publish wheels for a new Python months after
    // its release, and until then pip finds no distribution at all. Inside the
    // routine group such a bump blocked every other update (#293). It gets
    // its own PR, held back like a major, and is merged by hand once the plan
    // scripts job passes. Patches of the pinned minor stay routine.
    {
      matchDepNames: ['python'],
      matchUpdateTypes: ['major', 'minor'],
      groupName: null,
      automerge: false,
    },
  ],
}
